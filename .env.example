# Supabase — copie de Settings > API no painel do Supabase
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Secrets das Edge Functions (nunca no .env do frontend) ──────────────────
# Configure via: supabase secrets set NOME=valor

# Supabase Service Role Key — Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Credenciais de envio Z-API (instance_id/token/client_token) são POR UNIDADE,
# guardadas em whatsapp_channels.credentials e configuradas no painel
# /platform/automacao/<slug> — NÃO há mais env var global de envio.

# Segredo do webhook Z-API — gere com `openssl rand -hex 32`.
# Configure no painel Z-API como header customizado: X-Webhook-Secret: <valor>
ZAPI_WEBHOOK_SECRET=

# Chave interna para chamadas autenticadas entre Edge Functions e DB Webhooks.
# Gere com `openssl rand -hex 32`. Use no header X-Internal-Key.
INTERNAL_API_KEY=

# ─── E-mail (Resend) — opcional ──────────────────────────────────────────────
# Se ausente, send-confirmation pula o e-mail silenciosamente (WhatsApp continua).
# Cadastre domínio em resend.com e configure DNS (SPF/DKIM/DMARC) antes de usar.

# API key — resend.com/api-keys
RESEND_API_KEY=re_...

# Remetente — formato "Nome <email@dominio.com>". Use onboarding@resend.dev em testes.
RESEND_FROM_EMAIL=Moralles Reservas <reservas@seudominio.com.br>

# ─── Stripe (pagamento de caução) ────────────────────────────────────────────
# Chave secreta da plataforma — dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret — dashboard.stripe.com/webhooks (endpoint para stripe-webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# URL base da aplicação (usada nas return URLs do Checkout)
APP_BASE_URL=https://reservas.moralles.com.br

# ─── API Keys dos provedores de IA ───────────────────────────────────────────
# Configure APENAS o provedor que estiver usando no painel admin (Configurações > Provedor de IA)

# Claude (Anthropic) — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — platform.openai.com
OPENAI_API_KEY=sk-...

# Gemini (Google) — aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# Grok (xAI) — console.x.ai
GROK_API_KEY=xai-...

# DeepSeek — platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
