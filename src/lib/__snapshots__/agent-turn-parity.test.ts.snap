exports[`turno do agente no webhook-whatsapp real — paridade comportamental > ida e volta de ferramentas de leitura 1`] = `
{
  "conversation": [
    {
      "ai_lock_token": null,
      "handoff_at": null,
      "handoff_reason": null,
      "messages": [
        {
          "author": "customer",
          "content": "Tenho reserva?",
          "event_id": "wa-in:datafy:wamid.synthetic-incoming",
